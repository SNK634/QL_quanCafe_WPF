<Window x:Class="QL_quanCafe.Views.Core.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Quên mật khẩu" Height="368" Width="355" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="10,21,10,20">
        <!-- Đã xóa phần Tên đăng nhập ở đây -->

        <TextBlock Text="Email đã đăng ký:" Margin="0,5,0,0"/>
        <TextBox x:Name="txtEmail" Margin="0,5,0,10" Height="36" Width="312"/>

        <TextBlock Text="Mật khẩu mới:" Margin="0,5,0,0"/>
        <PasswordBox x:Name="txtNewPass" Margin="0,5,0,20" Height="38" Width="312"/>
        <Button Content="Xác nhận đổi mật khẩu" Click="Reset_Click" Background="#5D4037" Foreground="White" Height="41" Margin="0,0,-1,0"/>
    </StackPanel>
</Window>