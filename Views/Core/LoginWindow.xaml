<Window x:Class="QL_quanCafe.Views.Core.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QL_quanCafe.Views.Core"
        mc:Ignorable="d"
        Title="Đăng Nhập - Coffee Shop" Height="600" Width="477"
        WindowStartupLocation="CenterScreen" Background="#F9F6F0" ResizeMode="NoResize">

    <Grid>
        <!-- Đã chỉnh lại Margin cân đối khoảng cách trên dưới -->
        <Border Background="White" CornerRadius="15" Margin="30,40,30,40" SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Color="Gray" Opacity="0.2" ShadowDepth="2"/>
            </Border.Effect>

            <StackPanel Margin="20" VerticalAlignment="Center">
                <!-- Logo Cafe -->
                <Image Source="/Images/image_d69ce4.png" Height="100" Margin="0,0,0,20" Stretch="Uniform"/>

                <TextBlock Text="ĐĂNG NHẬP" FontSize="22" FontWeight="Bold" 
                           Foreground="#4A2E1B" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <!-- Tài khoản -->
                <TextBlock Text="Tên đăng nhập" Foreground="#6F4E37" Margin="0,0,0,5" FontWeight="SemiBold"/>
                <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" 
                         Height="35" Margin="0,0,0,15" Padding="5" 
                         BorderBrush="#8B5A2B" BorderThickness="1" VerticalContentAlignment="Center"/>

                <!-- Mật khẩu -->
                <TextBlock Text="Mật khẩu" Foreground="#6F4E37" Margin="0,0,0,5" FontWeight="SemiBold"/>

                <Grid Margin="0,0,0,5">
                    <PasswordBox x:Name="txtPassword" 
                                 Height="35" Padding="5" 
                                 BorderBrush="#8B5A2B" BorderThickness="1" VerticalContentAlignment="Center"
                                 PasswordChanged="txtPassword_PasswordChanged"/>

                    <TextBox x:Name="txtVisiblePassword" 
                             Height="35" Padding="5" 
                             BorderBrush="#8B5A2B" BorderThickness="1" VerticalContentAlignment="Center"
                             Visibility="Collapsed" 
                             TextChanged="txtVisiblePassword_TextChanged"/>
                </Grid>

                <CheckBox x:Name="chkShowPassword" Content="Hiển thị mật khẩu" 
                          Foreground="#5D4037" Margin="0,0,0,15" Cursor="Hand"
                          Checked="chkShowPassword_Checked" Unchecked="chkShowPassword_Unchecked"/>
                <!-- Nút Đăng nhập thường -->
                <Button Command="{Binding LoginCommand}" CommandParameter="{Binding ElementName=txtPassword}" 
                        Content="ĐĂNG NHẬP" Height="40" Background="#6F4E37" Foreground="White" 
                        FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- Nút Đăng nhập bằng Google -->
                <!-- Xóa bỏ nút Google cũ và thay bằng đoạn này -->
                <TextBlock Text="Quên mật khẩu?" 
           HorizontalAlignment="Center" 
           Margin="0,10,0,0" 
           Cursor="Hand" 
           Foreground="#5D4037" 
           TextDecorations="Underline"
           MouseLeftButtonDown="ForgotPassword_Click" FontSize="16"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>