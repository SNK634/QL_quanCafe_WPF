<UserControl x:Class="QL_quanCafe.Views.Admin.PerformanceReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FDFBF7">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HÀNG 1: Tiêu đề & Nút quay lại -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Button Click="BtnBack_Click" Content="🡨 Quay lại" Background="Transparent" BorderThickness="0" Foreground="#5D4037" FontWeight="Bold" FontSize="16" Cursor="Hand" Margin="0,0,20,0"/>
            <TextBlock Text="⭐ ĐÁNH GIÁ HIỆU SUẤT NHÂN VIÊN" FontSize="24" FontWeight="Bold" Foreground="#5D4037" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- HÀNG 2: Chia 2 cột (Danh sách NV & Khung đánh giá) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <!-- Cột trái nhỏ hơn chút -->
                <ColumnDefinition Width="2*"/>
                <!-- Cột phải to hơn để chứa Form -->
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: DANH SÁCH NHÂN VIÊN -->
            <DataGrid x:Name="DgEmployees" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True" 
                      HeadersVisibility="Column" Background="White" RowHeight="45" Margin="0,0,20,0"
                      SelectionChanged="DgEmployees_SelectionChanged" Cursor="Hand" BorderBrush="#D7CCC8" BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="Họ và Tên Nhân Viên" Binding="{Binding FullName}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Chức Vụ" Binding="{Binding Role}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- CỘT PHẢI: FORM CHẤM ĐIỂM KPI -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" BorderBrush="#D7CCC8" BorderThickness="1" Padding="25" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="PHIẾU CHẤM ĐIỂM THÁNG" FontSize="18" FontWeight="Bold" Foreground="#4E342E" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock x:Name="TxtSelectedEmployee" Text="(Vui lòng chọn 1 nhân viên bên danh sách)" FontSize="16" FontWeight="Bold" Foreground="#F57C00" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                    <!-- Tiêu chí 1: Thái độ -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Thái độ phục vụ khách:" FontWeight="Bold" Foreground="#4E342E" VerticalAlignment="Center"/>
                        <Slider x:Name="SldAttitude" Grid.Column="1" Minimum="1" Maximum="10" Value="8" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="SldAttitude_ValueChanged" Cursor="Hand"/>
                        <TextBlock x:Name="TxtAttitudeVal" Grid.Column="2" Text="8" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="18"/>
                    </Grid>

                    <!-- Tiêu chí 2: Kỹ năng -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Kỹ năng bán hàng/Pha chế:" FontWeight="Bold" Foreground="#4E342E" VerticalAlignment="Center"/>
                        <Slider x:Name="SldSkill" Grid.Column="1" Minimum="1" Maximum="10" Value="7" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="SldSkill_ValueChanged" Cursor="Hand"/>
                        <TextBlock x:Name="TxtSkillVal" Grid.Column="2" Text="7" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="18"/>
                    </Grid>

                    <!-- Tiêu chí 3: Tuân thủ nội quy -->
                    <Grid Margin="0,0,0,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tuân thủ nội quy/Giờ giấc:" FontWeight="Bold" Foreground="#4E342E" VerticalAlignment="Center"/>
                        <Slider x:Name="SldDiscipline" Grid.Column="1" Minimum="1" Maximum="10" Value="9" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="SldDiscipline_ValueChanged" Cursor="Hand"/>
                        <TextBlock x:Name="TxtDisciplineVal" Grid.Column="2" Text="9" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="18"/>
                    </Grid>

                    <!-- Khung Nhận xét chung -->
                    <TextBlock Text="Nhận xét chung của Quản lý:" FontWeight="Bold" Foreground="#4E342E" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtComments" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Padding="10" FontSize="14" BorderBrush="#BCAAA4" BorderThickness="1" Margin="0,0,0,20">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <!-- Nút Lưu -->
                    <Button Click="BtnSaveReview_Click" Content="💾 Lưu Đánh Giá" Height="45" Background="#FF5B9CA4" Foreground="White" FontWeight="Bold" FontSize="16" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>