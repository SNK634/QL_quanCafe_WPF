<UserControl x:Class="QL_quanCafe.Views.Admin.EmployeeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <!-- ĐỊNH NGHĨA KÍCH THƯỚC VÀ KIỂU DÁNG 1 Ô CHUẨN -->
        <Style x:Key="SquareCardStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#4CA1FE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="140"/>
            <Setter Property="Margin" Value="15"/>
            <!-- Tạo khoảng cách thở đều đặn 4 phía -->
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Margin=2 giúp khi rê chuột viền dày lên không bị cắt mất -->
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="12" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F4FAFF"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- BỐ CỤC TỔNG THỂ CỦA TRANG -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề trang -->
        <TextBlock Grid.Row="0" Text="QUẢN LÝ NHÂN SỰ" FontSize="24" FontWeight="Bold" Foreground="#FFC98074" Margin="10,0,0,20"/>

        <!-- BỌC BẰNG VIEWBOX: Tự động co giãn, luôn canh giữa hoàn hảo -->
        <Viewbox Grid.Row="1" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0">
            <!-- BẢNG GRID 3 CỘT 2 HÀNG -->
            <UniformGrid Columns="3" Rows="2">

                <!-- Ô 1: Danh sách nhân viên -->
                <Button Style="{StaticResource SquareCardStyle}" Click="BtnEmployeeList_Click">
                    <StackPanel>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE716;" FontSize="48" HorizontalAlignment="Center" Foreground="#333333" Margin="0,0,0,10"/>
                        <TextBlock Text="Danh sách nhân viên" FontSize="15" HorizontalAlignment="Center" Foreground="#333333"/>
                    </StackPanel>
                </Button>

                <!-- Ô 2: Thêm nhân viên mới -->
                <Button Style="{StaticResource SquareCardStyle}" Click="BtnAdd_Click">
                    <StackPanel>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8FA;" FontSize="48" HorizontalAlignment="Center" Foreground="#333333" Margin="0,0,0,10"/>
                        <TextBlock Text="Thêm nhân viên mới" FontSize="15" HorizontalAlignment="Center" Foreground="#333333"/>
                    </StackPanel>
                </Button>

                <!-- Ô 3: Phân quyền tài khoản -->
                <Button Style="{StaticResource SquareCardStyle}" Click="BtnRole_Click">
                    <StackPanel>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72D;" FontSize="48" HorizontalAlignment="Center" Foreground="#333333" Margin="0,0,0,10"/>
                        <TextBlock Text="Phân quyền tài khoản" FontSize="15" HorizontalAlignment="Center" Foreground="#333333"/>
                    </StackPanel>
                </Button>

                <!-- Ô 4: Lịch làm việc -->
                <Button Style="{StaticResource SquareCardStyle}" Click="BtnWorkSchedule_Click">
                    <StackPanel>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE787;" FontSize="48" HorizontalAlignment="Center" Foreground="#333333" Margin="0,0,0,10"/>
                        <TextBlock Text="Lịch làm việc" FontSize="15" HorizontalAlignment="Center" Foreground="#333333"/>
                    </StackPanel>
                </Button>

                <!-- Ô 5: Bảng tính lương -->
                <Button Style="{StaticResource SquareCardStyle}" Click="BtnPayroll_Click">
                    <StackPanel>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE83F;" FontSize="48" HorizontalAlignment="Center" Foreground="#333333" Margin="0,0,0,10"/>
                        <TextBlock Text="Bảng tính lương" FontSize="15" HorizontalAlignment="Center" Foreground="#333333"/>
                    </StackPanel>
                </Button>

                <!-- Ô 6: Đánh giá hiệu suất -->
                <Button Style="{StaticResource SquareCardStyle}" Click="BtnPerformance_Click">
                    <StackPanel>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE734;" FontSize="48" HorizontalAlignment="Center" Foreground="#333333" Margin="0,0,0,10"/>
                        <TextBlock Text="Đánh giá hiệu suất" FontSize="15" HorizontalAlignment="Center" Foreground="#333333"/>
                    </StackPanel>
                </Button>

            </UniformGrid>
        </Viewbox>
    </Grid>
</UserControl>