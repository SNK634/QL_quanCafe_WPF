<UserControl x:Class="QL_quanCafe.Views.Admin.EditEmployeeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FDFBF7">
    <Grid Margin="30">

        <!-- Nút Quay lại -->
        <Button Click="BtnBack_Click" Content="🡨 Quay lại" HorizontalAlignment="Left" VerticalAlignment="Top" 
                Background="Transparent" BorderThickness="0" Foreground="#5D4037" FontWeight="Bold" FontSize="16" Cursor="Hand"/>

        <!-- KHUNG FORM CHỈNH SỬA CHÍNH GIỮA -->
        <Border Background="White" CornerRadius="12" BorderBrush="#D7CCC8" BorderThickness="1" 
                Width="450" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30">

            <StackPanel>
                <TextBlock Text="✏ SỬA THÔNG TIN" FontSize="24" FontWeight="Bold" Foreground="#5D4037" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <!-- Nhập Họ và Tên -->
                <TextBlock Text="Họ và Tên:" FontWeight="Bold" Foreground="#4E342E" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtFullName" Height="40" Padding="10,0" FontSize="15" BorderBrush="#BCAAA4" BorderThickness="1" Margin="0,0,0,15">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <!-- Nhập Số điện thoại -->
                <TextBlock Text="Số điện thoại:" FontWeight="Bold" Foreground="#4E342E" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtPhone" Height="40" Padding="10,0" FontSize="15" BorderBrush="#BCAAA4" BorderThickness="1" Margin="0,0,0,15">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <!-- Nhập Email -->
                <TextBlock Text="Email liên hệ:" FontWeight="Bold" Foreground="#4E342E" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtEmail" Height="40" Padding="10,0" FontSize="15" BorderBrush="#BCAAA4" BorderThickness="1" Margin="0,0,0,15">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <!-- Chọn Chức vụ -->
                <TextBlock Text="Chức vụ:" FontWeight="Bold" Foreground="#4E342E" Margin="0,0,0,5"/>
                <ComboBox x:Name="CmbRole" Height="40" FontSize="15" BorderBrush="#BCAAA4" Margin="0,0,0,25" Padding="10,5">
                    <ComboBoxItem Content="Admin"/>
                    <ComboBoxItem Content="Nhân viên"/>
                </ComboBox>

                <!-- Nút Lưu thay đổi hiện tại -->
                <Button Click="BtnSave_Click" Content="💾 Lưu thay đổi" Height="45" Background="#FFDFA060" Foreground="White" FontWeight="Bold" FontSize="16" Cursor="Hand" Margin="0,0,0,10">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- THÊM NÚT ĐỔI MẬT KHẨU MỚI -->
                <Button Click="BtnChangePassword_Click" Content="🔑 Đổi mật khẩu mới" Height="40" Background="#FF754D44" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>