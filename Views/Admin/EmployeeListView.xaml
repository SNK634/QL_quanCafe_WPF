<UserControl x:Class="QL_quanCafe.Views.Admin.EmployeeListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FDFBF7">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HÀNG 1: TIÊU ĐỀ & CÁC NÚT -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Click="BtnBack_Click" Content="🡨 Quay lại" Background="Transparent" BorderThickness="0" Foreground="#5D4037" FontWeight="Bold" FontSize="16" Cursor="Hand" Margin="0,0,20,0"/>
                <TextBlock Text="DANH SÁCH NHÂN VIÊN" FontSize="24" FontWeight="Bold" Foreground="#5D4037" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Click="BtnExportExcel_Click" Content="📊 Xuất Excel" Width="120" Height="40" Background="#2E7D32" Foreground="White" FontWeight="Bold" Cursor="Hand" Margin="0,0,10,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Click="BtnPrint_Click" Content="🖨 In danh sách" Width="130" Height="40" Background="#5D4037" Foreground="White" FontWeight="Bold" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>

        <!-- HÀNG 2: BẢNG DỮ LIỆU CÓ THÊM ROW DETAIL THÔNG MINH -->
        <DataGrid x:Name="DgEmployees" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                  HeadersVisibility="Column" Background="White" RowHeight="45"
                  RowDetailsVisibilityMode="VisibleWhenSelected">
            <!-- Thuộc tính giúp thả khung Sửa/Xóa khi click -->

            <!-- GIAO DIỆN NÚT SỬA XÓA TRƯỢT RA BÊN DƯỚI DÒNG -->
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <Border Background="#FFF3E0" Padding="15,10" BorderBrush="#FFCC80" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Click="BtnEdit_Click" Tag="{Binding}" Content="✏ Sửa thông tin" 
                                    Width="120" Height="32" Background="#F57C00" Foreground="White" 
                                    FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Click="BtnDelete_Click" Tag="{Binding}" Content="🗑 Xóa nhân viên" 
                                    Width="120" Height="32" Background="#D32F2F" Foreground="White" 
                                    FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>

            <!-- CẤU TRÚC CỘT (Giữ nguyên) -->
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã NV" Binding="{Binding Id}" Width="70"/>
                <DataGridTextColumn Header="Tên Đăng Nhập" Binding="{Binding UserName}" Width="1.5*"/>
                <DataGridTextColumn Header="Họ và Tên" Binding="{Binding FullName}" Width="2*"/>
                <DataGridTextColumn Header="Số Điện Thoại" Binding="{Binding Phone}" Width="130"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*"/>
                <DataGridTextColumn Header="Chức Vụ" Binding="{Binding Role}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>