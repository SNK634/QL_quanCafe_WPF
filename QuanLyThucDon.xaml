<UserControl x:Class="QL_quanCafe.QuanLyThucDonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- FORM NHẬP / CHỈNH SỬA BÊN TRÁI -->
        <Border Grid.Column="0" Background="#EDF6F3" CornerRadius="10" Padding="15" Margin="0,0,15,0">
            <StackPanel>
                <TextBlock Text="THÔNG TIN MÓN" FontWeight="Bold" FontSize="16" Foreground="#2D3748" Margin="0,0,0,15"/>

                <TextBlock Text="Tên món:" Margin="0,5,0,2" FontWeight="SemiBold"/>
                <TextBox x:Name="txtProductName" Padding="8" Margin="0,0,0,10" FontSize="13"/>

                <TextBlock Text="Tên tiếng Anh / Mô tả:" Margin="0,5,0,2" FontWeight="SemiBold"/>
                <TextBox x:Name="txtSubName" Padding="8" Margin="0,0,0,10" FontSize="13"/>

                <TextBlock Text="Danh mục:" Margin="0,5,0,2" FontWeight="SemiBold"/>
                <ComboBox x:Name="cboCategory" Padding="8" Margin="0,0,0,10" FontSize="13">
                    <ComboBoxItem Content="Café" Tag="Cafe"/>
                    <ComboBoxItem Content="Trà" Tag="Tra"/>
                    <ComboBoxItem Content="Đá Xay" Tag="DaXay"/>
                    <ComboBoxItem Content="Nước Ép" Tag="NuocEp"/>
                    <ComboBoxItem Content="Topping" Tag="Topping"/>
                    <ComboBoxItem Content="Trà Sữa" Tag="TraSua"/>
                    <ComboBoxItem Content="Yogurt" Tag="Yogurt"/>
                </ComboBox>

                <TextBlock Text="Giá bán (VNĐ):" Margin="0,5,0,2" FontWeight="SemiBold"/>
                <TextBox x:Name="txtPrice" Padding="8" Margin="0,0,0,15" FontSize="13"/>

                <CheckBox x:Name="chkIsAvailable" Content="Đang kinh doanh" IsChecked="True" Margin="0,0,0,20" FontWeight="SemiBold"/>

                <!-- NÚT THAO TÁC -->
                <Button Content="➕ Thêm Món Mới" Click="BtnAdd_Click" Height="38" Margin="0,4" Background="#48BB78" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                <Button Content="✏️ Cập Nhật" Click="BtnUpdate_Click" Height="38" Margin="0,4" Background="#4299E1" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                <Button Content="🗑️ Xóa Món" Click="BtnDelete_Click" Height="38" Margin="0,4" Background="#E53E3E" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- BẢNG DANH SÁCH MÓN BÊN PHẢI (ĐÃ CHỈNH FULL BẢNG) -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- KHU VỰC TÌM KIẾM -->
            <Border Grid.Row="0" Margin="0,0,0,15">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="🔍 Tìm kiếm món:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0" FontSize="13"/>
                    <TextBox x:Name="txtSearch" Padding="8" TextChanged="TxtSearch_TextChanged" FontSize="13"/>
                </DockPanel>
            </Border>

            <!-- DATAGRID TỰ ĐỘNG DÃN RỘNG FULL KHUNG -->
            <DataGrid Grid.Row="1" x:Name="dgProducts" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      SelectionChanged="DgProducts_SelectionChanged"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E2E8F0"
                      RowHeight="35"
                      Background="White"
                      BorderBrush="#CBD5E0"
                      BorderThickness="1"
                      ColumnWidth="*"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#4A2E1B"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Height" Value="40"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.Resources>

           
                    <DataGrid.Columns>
                        <!-- 1. Cột Tên Món: Binding vào Name -->
                        <DataGridTextColumn Header="Tên Món" Binding="{Binding Name}" Width="1.5*"/>

                        <!-- 2. Cột Mô tả / Tiếng Anh: Binding vào SubName -->
                        <DataGridTextColumn Header="Mô Tả / Tên Tiếng Anh" Binding="{Binding SubName}" Width="2*"/>

                        <!-- 3. Cột Danh Mục: Binding vào CategoryCode (hoặc CategoryName) -->
                        <DataGridTextColumn Header="Danh Mục" Binding="{Binding CategoryCode}" Width="1*"/>

                        <!-- 4. Cột Giá Bán: Binding vào Price -->
                        <DataGridTextColumn Header="Giá Bán (VNĐ)" Binding="{Binding Price, StringFormat={}{0:N0}}" Width="1*"/>
                    </DataGrid.Columns>
                </DataGrid>
        </Grid>
    </Grid>
</UserControl>